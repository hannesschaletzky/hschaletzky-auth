# Copy to .env for local development. Placeholder values only — never commit real secrets.
# In production, secrets are passed as files instead: X_FILE=/run/secrets/...
# (supported for all passwords, BETTER_AUTH_SECRET and the GitHub client id/secret).

# Owner role: used by docker compose and the migration step (local Postgres on port 5433)
POSTGRES_PASSWORD=change-me-owner
MIGRATION_DATABASE_URL=postgres://auth:change-me-owner@localhost:5433/auth

# Least-privilege role the app connects with; created and updated by `npm run db:migrate`
APP_DB_PASSWORD=change-me-app-local-only
DATABASE_URL=postgres://auth_app:change-me-app-local-only@localhost:5433/auth

PORT=4000
# Public origin; becomes the token issuer
PUBLIC_BASE_URL=http://localhost:4000
# openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long

# GitHub OAuth App, callback: <PUBLIC_BASE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ids allowed to sign in: curl https://api.github.com/users/<login>
ALLOWED_GITHUB_USER_IDS=

# Protected resources tokens can be issued for (comma-separated)
RESOURCES=http://localhost:3000/mcp
# Optional: redirect URIs dynamically registered clients may use (default: claude.ai's callback)
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
